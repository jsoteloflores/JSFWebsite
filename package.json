{
  "name": "jsf-portfolio",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "content:validate": "tsx scripts/validate-content.ts",
    "site:verify": "tsx scripts/verify-site.ts",
    "validate": "npm run format:check && npm run lint && npm run typecheck && npm run content:validate && npm run test && npm run build && npm run site:verify"
  },
  "dependencies": {
    "astro": "^7.1.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@eslint/js": "^9.30.0",
    "@types/node": "^26.1.1",
    "eslint": "^9.30.0",
    "eslint-plugin-astro": "^1.4.0",
    "gray-matter": "^4.0.3",
    "prettier": "^3.6.0",
    "prettier-plugin-astro": "^0.14.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.35.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "sharp@0.34.5": true,
    "esbuild@0.28.1": true
  }
}
