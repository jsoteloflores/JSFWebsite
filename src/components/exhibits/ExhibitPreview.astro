---
/**
 * ExhibitPreview — renders a preview card for an external interactive exhibit.
 * Only renders records already filtered as visible and available.
 * Does not embed the exhibit, autoplay media, or emit runtime code.
 * Link text must describe the destination.
 * No client-side JavaScript.
 */
import type { ExhibitFrontmatter } from '../../types/content-schemas';
import { buildExhibitLinkText } from '../../utils/content-display';

interface Props {
  data: ExhibitFrontmatter;
  /** Optional human-readable name of the related project, for context. */
  relatedProjectTitle?: string;
}

const { data, relatedProjectTitle } = Astro.props;

const linkText = buildExhibitLinkText(data.title);
---

<article class="exhibit-preview">
  <figure class="exhibit-preview__figure">
    <img
      src={data.previewImage.src}
      alt={data.previewImage.alt}
      class="exhibit-preview__image"
      loading="lazy"
      decoding="async"
      width="800"
      height="450"
    />
    {
      data.previewImage.caption && (
        <figcaption class="exhibit-preview__caption">
          {data.previewImage.caption}
        </figcaption>
      )
    }
  </figure>

  <div class="exhibit-preview__content">
    <header class="exhibit-preview__header">
      <h3 class="exhibit-preview__title">{data.title}</h3>
      {
        relatedProjectTitle && (
          <p class="exhibit-preview__context">Part of: {relatedProjectTitle}</p>
        )
      }
    </header>

    <p class="exhibit-preview__summary">{data.summary}</p>

    {
      data.estimatedExperienceLength && (
        <p class="exhibit-preview__duration">
          Approximately {data.estimatedExperienceLength}
        </p>
      )
    }

    <a
      href={data.externalUrl}
      class="exhibit-preview__link"
      rel="noopener noreferrer"
      target="_blank"
    >
      {linkText}
      <span class="exhibit-preview__link-indicator" aria-hidden="true"> ↗</span>
    </a>
  </div>
</article>

<style>
  .exhibit-preview {
    border: 1px solid var(--color-charcoal);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .exhibit-preview__figure {
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background-color: var(--color-charcoal);
  }

  .exhibit-preview__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .exhibit-preview__caption {
    font-size: 0.8125rem;
    color: var(--color-stone);
    padding: var(--space-2) var(--space-4);
    background-color: var(--color-basalt);
  }

  .exhibit-preview__content {
    padding: var(--space-6);
  }

  .exhibit-preview__title {
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ivory);
    margin: 0 0 var(--space-2);
  }

  .exhibit-preview__context {
    font-size: 0.8125rem;
    color: var(--color-stone);
    margin: 0 0 var(--space-3);
  }

  .exhibit-preview__summary {
    font-size: 0.9375rem;
    color: var(--color-ash);
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }

  .exhibit-preview__duration {
    font-size: 0.8125rem;
    font-family: var(--font-mono);
    color: var(--color-stone);
    margin: 0 0 var(--space-4);
  }

  .exhibit-preview__link {
    display: inline-block;
    font-size: 0.875rem;
    color: var(--color-sandstone);
    text-decoration: none;
    border: 1px solid var(--color-stone);
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-sm);
    transition:
      border-color var(--transition-duration) var(--transition-easing),
      color var(--transition-duration) var(--transition-easing);
  }

  .exhibit-preview__link:hover {
    border-color: var(--color-sandstone);
    color: var(--color-ivory);
  }

  .exhibit-preview__link-indicator {
    font-size: 0.875em;
  }
</style>
