---
import '../styles/global.css';
import { navigation } from '../utils/navigation';
import { profile } from '../data/profile';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();

function isActive(href: string, path: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | {profile.displayName}</title>
    <meta name="description" content={description} />
    <!-- Editorial serif + clean sans-serif web fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="content-wrapper site-header__inner">
        <a href="/" class="site-header__branding">{profile.displayName}</a>
        <nav aria-label="Primary navigation">
          <ul class="site-nav__list">
            {
              navigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="site-nav__link"
                    aria-current={isActive(item.href, currentPath) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main-content" class="site-main">
      <div class="content-wrapper">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="content-wrapper site-footer__inner">
        <div class="site-footer__identity">
          <p class="site-footer__name">{profile.displayName}</p>
          <p class="site-footer__tagline">
            Computational &amp; Physical Volcanology &mdash; {profile.location}
          </p>
        </div>
        <nav class="site-footer__links" aria-label="Footer contact links">
          <a href={`mailto:${profile.academicEmail}`} class="site-footer__link">
            {profile.academicEmail}
          </a>
          <a
            href={profile.githubUrl}
            class="site-footer__link"
            rel="noopener noreferrer"
            target="_blank"
          >
            GitHub
          </a>
          <a
            href={profile.linkedInUrl}
            class="site-footer__link"
            rel="noopener noreferrer"
            target="_blank"
          >
            LinkedIn
          </a>
        </nav>
        <p class="site-footer__copy">
          &copy; {year}
          {profile.displayName}
        </p>
      </div>
    </footer>
  </body>
</html>
