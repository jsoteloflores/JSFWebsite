---
import '../styles/global.css';
import { navigation } from '../utils/navigation';
import { profile } from '../data/profile';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  description: string;
  /**
   * contained (default): slot is wrapped in .layout-content (72rem max-width)
   * fluid: slot is placed directly in <main>; page manages its own widths
   */
  contentMode?: 'contained' | 'fluid';
  /**
   * Canonical URL (relative or absolute). If not provided, uses current URL.
   */
  canonical?: string;
  /**
   * Open Graph image path (relative to public/). Defaults to social preview image.
   */
  ogImage?: string;
  /**
   * Open Graph type. Defaults to 'website'.
   */
  ogType?: 'website' | 'article';
  /**
   * If true, adds noindex meta tag.
   */
  noindex?: boolean;
  /**
   * If true, adds JSON-LD Person structured data (homepage only).
   */
  includeStructuredData?: boolean;
}

const {
  title,
  description,
  contentMode = 'contained',
  canonical,
  ogImage = '/social/joel-sotelo-flores-og.jpg',
  ogType = 'website',
  noindex = false,
  includeStructuredData = false,
} = Astro.props;

const currentPath = Astro.url.pathname;
const year = new Date().getFullYear();
const site = Astro.site || new URL('https://joelsoteloflores.rocks');

// Homepage gets special title treatment (no suffix)
const isHomepage = currentPath === '/';
const fullTitle = isHomepage ? title : `${title} | ${profile.displayName}`;

// Construct canonical URL
const canonicalUrl = canonical
  ? canonical.startsWith('http')
    ? canonical
    : new URL(canonical, site).toString()
  : new URL(currentPath, site).toString();

// Construct Open Graph image URL
const ogImageUrl = new URL(ogImage, site).toString();

// Construct Open Graph URL (same as canonical)
const ogUrl = canonicalUrl;

// JSON-LD structured data for Person (homepage only)
const structuredData = includeStructuredData
  ? {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: profile.displayName,
      url: site.toString(),
      sameAs: [profile.githubUrl, profile.linkedInUrl],
      affiliation: {
        '@type': 'CollegeOrUniversity',
        name: profile.institution,
      },
      description:
        'Undergraduate researcher in computational and physical volcanology.',
    }
  : null;

function isActive(href: string, path: string): boolean {
  if (href === '/') return path === '/';
  return path === href || path.startsWith(href + '/');
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <!-- Open Graph -->
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={ogUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:site_name" content={profile.displayName} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    {
      structuredData && (
        <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
      )
    }

    <!-- Editorial serif + clean sans-serif web fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Lora:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to main content</a>

    <header class="site-header">
      <div class="layout-wide site-header__inner">
        <a href="/" class="site-header__branding">{profile.displayName}</a>
        <nav aria-label="Primary navigation">
          <ul class="site-nav__list">
            {
              navigation.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="site-nav__link"
                    aria-current={isActive(item.href, currentPath) ? 'page' : undefined}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main
      id="main-content"
      class={`site-main${contentMode === 'fluid' ? ' site-main--fluid' : ''}`}
    >
      {
        contentMode === 'contained' ? (
          <div class="layout-content">
            <slot />
          </div>
        ) : (
          <slot />
        )
      }
    </main>

    <footer class="site-footer">
      <div class="layout-wide site-footer__inner">
        <div class="site-footer__identity">
          <p class="site-footer__name">{profile.displayName}</p>
          <p class="site-footer__tagline">
            Computational &amp; Physical Volcanology &mdash; {profile.location}
          </p>
        </div>
        <nav class="site-footer__links" aria-label="Footer contact links">
          <a href={`mailto:${profile.academicEmail}`} class="site-footer__link">
            {profile.academicEmail}
          </a>
          <a
            href={profile.githubUrl}
            class="site-footer__link"
            rel="noopener noreferrer"
            target="_blank"
          >
            GitHub
          </a>
          <a
            href={profile.linkedInUrl}
            class="site-footer__link"
            rel="noopener noreferrer"
            target="_blank"
          >
            LinkedIn
          </a>
        </nav>
        <p class="site-footer__copy">
          &copy; {year}
          {profile.displayName}
        </p>
      </div>
    </footer>
  </body>
</html>
