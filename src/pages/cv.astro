---
/**
 * Dedicated web CV page.
 * Browser-readable curriculum vitae connecting to deeper site pages.
 * Provides clear download link to current PDF CV.
 * No iframe/PDF embed — web-native editorial presentation.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import StatusLabel from '../components/core/StatusLabel.astro';
import PublicationEntry from '../components/publications/PublicationEntry.astro';
import { profile } from '../data/profile';
import {
  education,
  researchExperience,
  manuscriptsUnderReview,
  manuscriptsInPreparation,
  software,
  completedPresentations,
  submittedConferenceAbstracts,
  awards,
  training,
  teaching,
} from '../data/cv';
import { getPublicProjects } from '../utils/content-queries';
import { filterPublic } from '../utils/content-filter';

// Fetch collections
const projects = await getPublicProjects();
const allPubs = await getCollection('publications');
const publicPubs = filterPublic(allPubs);

// Create project lookup
const projectById = new Map(projects.map((p) => [p.id, p]));

// Find published peer-reviewed publication (JDSO paper)
const peerReviewedPub = publicPubs.find((p) => p.data.status === 'published');
---

<BaseLayout
  title="Curriculum Vitae"
  description="Curriculum vitae for Joel Sotelo Flores, an undergraduate researcher in computational and physical volcanology at Washington and Lee University."
  contentMode="contained"
>
  <div class="cv-page">
    <header class="cv-header">
      <p class="cv-header__label">Curriculum Vitae</p>
      <h1 class="cv-header__name">{profile.displayName}</h1>
      <div class="cv-header__affiliation">
        <p>
          {profile.degrees[0]} · {profile.degrees[1]}
        </p>
        <p>{profile.institution}</p>
        <p>Expected {profile.expectedGraduation}</p>
        <p>{profile.location}</p>
      </div>
      <div class="cv-header__actions">
        <a href={profile.cvPath} download class="cv-download-btn"> Download PDF ↓ </a>
        <div class="cv-header__links">
          <a href={`mailto:${profile.academicEmail}`}>{profile.academicEmail}</a>
          <span class="cv-header__separator">·</span>
          <a href={profile.githubUrl} target="_blank" rel="noopener noreferrer"
            >GitHub</a
          >
          <span class="cv-header__separator">·</span>
          <a href={profile.linkedInUrl} target="_blank" rel="noopener noreferrer"
            >LinkedIn</a
          >
        </div>
      </div>
    </header>

    <div class="cv-content">
      <!-- Education -->
      <section class="cv-section" id="education">
        <h2 class="cv-section__heading">Education</h2>
        <div class="cv-section__content">
          <div class="cv-entry">
            <div class="cv-entry__header">
              <div class="cv-entry__title-group">
                <h3 class="cv-entry__title">{profile.institution}</h3>
                <p class="cv-entry__subtitle">
                  {profile.degrees.join(', ')}
                </p>
              </div>
              <p class="cv-entry__date">Expected {profile.expectedGraduation}</p>
            </div>
            <div class="cv-entry__body">
              <p class="cv-entry__detail">
                <strong>Honors Thesis:</strong>
                {education.honorsThesisTitle}
              </p>
              <p class="cv-entry__detail">
                <strong>Study Abroad:</strong>
                {education.studyAbroadProgram}, {education.studyAbroadLocation} (May 2024)
              </p>
              <div class="cv-coursework">
                <p class="cv-coursework__label">Relevant Coursework:</p>
                <p class="cv-coursework__list">
                  {education.relevantCoursework.join(', ')}
                </p>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- Research Experience -->
      <section class="cv-section" id="research-experience">
        <h2 class="cv-section__heading">Research Experience</h2>
        <div class="cv-section__content">
          {
            researchExperience.map((exp) => {
              const relatedProject = exp.projectId
                ? projectById.get(exp.projectId)
                : null;
              const startDate = new Date(exp.startDate);
              const endDate = exp.endDate ? new Date(exp.endDate) : null;
              const dateRange = `${startDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })} – ${endDate ? endDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : 'Present'}`;

              return (
                <div class="cv-entry">
                  <div class="cv-entry__header">
                    <div class="cv-entry__title-group">
                      <h3 class="cv-entry__title">{exp.roleTitle}</h3>
                      <p class="cv-entry__subtitle">
                        {exp.institution} · {exp.location}
                      </p>
                      <p class="cv-entry__advisor">Advisor: {exp.advisor}</p>
                    </div>
                    <p class="cv-entry__date">{dateRange}</p>
                  </div>
                  <div class="cv-entry__body">
                    <ul class="cv-entry__bullets">
                      {exp.bullets.map((bullet) => (
                        <li>{bullet}</li>
                      ))}
                    </ul>
                    {relatedProject && (
                      <p class="cv-entry__link">
                        <a href={`/research/${exp.projectId}`}>View research →</a>
                      </p>
                    )}
                  </div>
                </div>
              );
            })
          }
        </div>
      </section>

      <!-- Publications & Manuscripts -->
      <section class="cv-section" id="publications">
        <h2 class="cv-section__heading">Publications & Manuscripts</h2>

        <!-- Peer-Reviewed Publications -->
        <div class="cv-subsection">
          <h3 class="cv-subsection__heading">Peer-Reviewed Publications</h3>
          {
            peerReviewedPub && (
              <div class="cv-publication">
                <PublicationEntry data={peerReviewedPub.data} />
              </div>
            )
          }
        </div>

        <!-- Manuscripts Under Review -->
        {
          manuscriptsUnderReview.length > 0 && (
            <div class="cv-subsection">
              <h3 class="cv-subsection__heading">Manuscripts Under Review</h3>
              {manuscriptsUnderReview.map((ms) => (
                <div class="cv-manuscript">
                  <p class="cv-manuscript__citation">
                    {ms.authors.join(', ')}. "{ms.title}" Submitted to{' '}
                    {ms.targetJournal}.
                  </p>
                  <StatusLabel status="in-review" />
                </div>
              ))}
            </div>
          )
        }

        <!-- Manuscripts in Preparation -->
        {
          manuscriptsInPreparation.length > 0 && (
            <div class="cv-subsection">
              <h3 class="cv-subsection__heading">Manuscripts in Preparation</h3>
              {manuscriptsInPreparation.map((ms) => (
                <div class="cv-manuscript">
                  <p class="cv-manuscript__citation">
                    {ms.authors.join(', ')}. "{ms.title}" Planned submission to{' '}
                    {ms.targetJournal}.
                  </p>
                  <StatusLabel status="in-preparation" />
                </div>
              ))}
            </div>
          )
        }
      </section>

      <!-- Software & Research Products -->
      <section class="cv-section" id="software">
        <h2 class="cv-section__heading">Software & Research Products</h2>
        <div class="cv-section__content">
          {
            software.map((sw) => {
              const relatedProject = sw.projectId
                ? projectById.get(sw.projectId)
                : null;
              return (
                <div class="cv-entry cv-entry--compact">
                  <h3 class="cv-entry__title cv-entry__title--software">{sw.name}</h3>
                  <p class="cv-entry__description">{sw.description}</p>
                  {relatedProject && (
                    <p class="cv-entry__link">
                      <a href={`/research/${sw.projectId}`}>Related research →</a>
                    </p>
                  )}
                </div>
              );
            })
          }
        </div>
      </section>

      <!-- Presentations -->
      <section class="cv-section" id="presentations">
        <h2 class="cv-section__heading">Presentations</h2>

        <!-- Completed Presentations -->
        <div class="cv-subsection">
          <h3 class="cv-subsection__heading">Completed Presentations</h3>
          {
            completedPresentations.map((pres) => {
              const presDate = new Date(pres.date);
              const formattedDate = presDate.toLocaleDateString('en-US', {
                month: 'long',
                year: 'numeric',
              });
              return (
                <div class="cv-presentation">
                  <p class="cv-presentation__citation">
                    {pres.authors.join(', ')}. "{pres.title}"{' '}
                    {pres.type === 'poster' ? 'Poster' : 'Oral presentation'},{' '}
                    {pres.venue}, {pres.location}, {formattedDate}.
                  </p>
                </div>
              );
            })
          }
        </div>

        <!-- Conference Abstracts Submitted -->
        {
          submittedConferenceAbstracts.length > 0 && (
            <div class="cv-subsection">
              <h3 class="cv-subsection__heading">Conference Abstracts Submitted</h3>
              {submittedConferenceAbstracts.map((abs) => (
                <div class="cv-abstract">
                  <p class="cv-abstract__citation">
                    {abs.authors.join(', ')}. "{abs.title}"{' '}
                    {abs.type === 'poster' ? 'Poster' : 'Oral presentation'} abstract
                    submitted to {abs.conference}.
                  </p>
                  <span class="cv-abstract__status">Abstract submitted</span>
                </div>
              ))}
            </div>
          )
        }
      </section>

      <!-- Awards, Fellowships, and Scholarships -->
      <section class="cv-section" id="awards">
        <h2 class="cv-section__heading">Awards, Fellowships & Scholarships</h2>
        <div class="cv-section__content">
          <div class="cv-list">
            {
              awards.map((award) => {
                const awardDate = new Date(award.date);
                const formattedDate = awardDate.toLocaleDateString('en-US', {
                  month: 'short',
                  year: 'numeric',
                });
                return (
                  <div class="cv-list__item">
                    <span class="cv-list__label">{award.name}</span>
                    <span class="cv-list__value">{formattedDate}</span>
                  </div>
                );
              })
            }
          </div>
        </div>
      </section>

      <!-- Research Training & Scientific Programs -->
      <section class="cv-section" id="training">
        <h2 class="cv-section__heading">Research Training & Scientific Programs</h2>
        <div class="cv-section__content">
          {
            training.map((prog) => {
              const progDate = new Date(prog.date);
              const formattedDate = progDate.toLocaleDateString('en-US', {
                month: 'long',
                year: 'numeric',
              });
              return (
                <div class="cv-entry cv-entry--compact">
                  <div class="cv-entry__header">
                    <div class="cv-entry__title-group">
                      <h3 class="cv-entry__title">{prog.programName}</h3>
                      <p class="cv-entry__subtitle">{prog.institution}</p>
                    </div>
                    <p class="cv-entry__date">{formattedDate}</p>
                  </div>
                  <ul class="cv-entry__bullets">
                    {prog.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              );
            })
          }
        </div>
      </section>

      <!-- Teaching & Mentoring -->
      <section class="cv-section" id="teaching">
        <h2 class="cv-section__heading">Teaching & Mentoring</h2>
        <div class="cv-section__content">
          {
            teaching.map((role) => {
              const startDate = new Date(role.startDate);
              const endDate = role.endDate ? new Date(role.endDate) : null;
              const dateRange = `${startDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })} – ${endDate ? endDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' }) : 'Present'}`;

              return (
                <div class="cv-entry cv-entry--compact">
                  <div class="cv-entry__header">
                    <div class="cv-entry__title-group">
                      <h3 class="cv-entry__title">{role.roleTitle}</h3>
                      <p class="cv-entry__subtitle">{role.institution}</p>
                    </div>
                    <p class="cv-entry__date">{dateRange}</p>
                  </div>
                  <ul class="cv-entry__bullets">
                    {role.bullets.map((bullet) => (
                      <li>{bullet}</li>
                    ))}
                  </ul>
                </div>
              );
            })
          }
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .cv-page {
    max-width: 900px;
    margin: 0 auto;
    padding-inline: var(--content-padding-inline);
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Header                                                          */
  /* ────────────────────────────────────────────────────────────── */

  .cv-header {
    margin-bottom: var(--space-16);
    padding-bottom: var(--space-10);
    border-bottom: 1px solid var(--color-border);
  }

  .cv-header__label {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }

  .cv-header__name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.1;
    margin: 0 0 var(--space-5);
    letter-spacing: -0.02em;
  }

  .cv-header__affiliation {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.6;
    margin-bottom: var(--space-6);
  }

  .cv-header__affiliation p {
    margin: 0;
  }

  .cv-header__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    align-items: flex-start;
  }

  .cv-download-btn {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    background-color: var(--color-wine);
    color: var(--color-ivory);
    font-weight: 600;
    font-size: 0.9375rem;
    text-decoration: none;
    border-radius: 4px;
    transition: background-color 0.2s ease;
  }

  .cv-download-btn:hover {
    background-color: var(--color-oxidized-red);
  }

  .cv-header__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    font-size: 0.875rem;
  }

  .cv-header__links a {
    color: var(--color-wine);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  .cv-header__separator {
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .cv-header__links {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-2);
    }

    .cv-header__separator {
      display: none;
    }
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Sections                                                        */
  /* ────────────────────────────────────────────────────────────── */

  .cv-section {
    margin-bottom: var(--space-16);
  }

  .cv-section__heading {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    margin: 0 0 var(--space-8);
    letter-spacing: -0.01em;
  }

  .cv-section__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-10);
  }

  .cv-subsection {
    margin-bottom: var(--space-8);
  }

  .cv-subsection:last-child {
    margin-bottom: 0;
  }

  .cv-subsection__heading {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.8125rem;
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Entries                                                         */
  /* ────────────────────────────────────────────────────────────── */

  .cv-entry {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cv-entry--compact {
    gap: var(--space-2);
  }

  .cv-entry__header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-6);
  }

  @media (max-width: 640px) {
    .cv-entry__header {
      flex-direction: column;
      gap: var(--space-2);
    }
  }

  .cv-entry__title-group {
    flex: 1;
  }

  .cv-entry__title {
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-1);
    line-height: 1.4;
  }

  .cv-entry__title--software {
    font-family: var(--font-mono);
    font-size: 0.9375rem;
  }

  .cv-entry__subtitle {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    margin: 0;
    line-height: 1.5;
  }

  .cv-entry__advisor {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: var(--space-1) 0 0;
    font-style: italic;
  }

  .cv-entry__date {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
    margin: 0;
  }

  .cv-entry__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cv-entry__detail {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  .cv-entry__description {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  .cv-entry__bullets {
    list-style: disc;
    padding-left: var(--space-5);
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cv-entry__bullets li {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    padding-left: var(--space-1);
  }

  .cv-entry__link {
    font-size: 0.875rem;
    margin: var(--space-1) 0 0;
  }

  .cv-entry__link a {
    color: var(--color-wine);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Coursework                                                      */
  /* ────────────────────────────────────────────────────────────── */

  .cv-coursework {
    padding-top: var(--space-2);
  }

  .cv-coursework__label {
    font-weight: 600;
    font-size: 0.9375rem;
    color: var(--color-text);
    margin: 0 0 var(--space-1);
  }

  .cv-coursework__list {
    font-size: 0.875rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0;
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Publications & Manuscripts                                      */
  /* ────────────────────────────────────────────────────────────── */

  .cv-publication {
    margin-bottom: var(--space-6);
  }

  .cv-manuscript {
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cv-manuscript__citation {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Presentations                                                   */
  /* ────────────────────────────────────────────────────────────── */

  .cv-presentation {
    margin-bottom: var(--space-4);
  }

  .cv-presentation__citation {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  .cv-abstract {
    margin-bottom: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .cv-abstract__citation {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    margin: 0;
  }

  .cv-abstract__status {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    display: inline-block;
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Lists                                                           */
  /* ────────────────────────────────────────────────────────────── */

  .cv-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .cv-list__item {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-4);
  }

  @media (max-width: 640px) {
    .cv-list__item {
      flex-direction: column;
      gap: var(--space-1);
    }
  }

  .cv-list__label {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.6;
    flex: 1;
  }

  .cv-list__value {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    white-space: nowrap;
  }
</style>
