---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/core/PageHeader.astro';
import PublicationEntry from '../components/publications/PublicationEntry.astro';
import { getPublicPublications } from '../utils/content-queries';

const publications = await getPublicPublications();
---

<BaseLayout
  title="Publications"
  description="Peer-reviewed publications and research outputs by Joel Sotelo Flores."
>
  <PageHeader
    eyebrow="Publications"
    title="Publications"
    description="Verified scholarly publications. Additional records will be added as manuscripts reach publicly documented stages."
  />

  {
    publications.length > 0 && (
      <section class="page-section">
        <h2 class="section-heading">Peer-reviewed publications</h2>
        {publications.map((pub) => (
          <PublicationEntry data={pub.data} />
        ))}
      </section>
    )
  }

  {
    publications.length === 0 && (
      <p class="empty-notice">No public publication records are currently available.</p>
    )
  }
</BaseLayout>

<style>
  .empty-notice {
    font-size: 0.9375rem;
    color: var(--color-stone);
  }
</style>
