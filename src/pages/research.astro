---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/core/PageHeader.astro';
import EditorialProjectLink from '../components/projects/EditorialProjectLink.astro';
import { getPublicProjects } from '../utils/content-queries';
import { projectUrl } from '../utils/site';

const allProjects = await getPublicProjects();
const activeProjects = allProjects.filter((p) => p.data.status === 'active');
const completedProjects = allProjects.filter((p) => p.data.status !== 'active');
---

<BaseLayout
  title="Research"
  description="Research projects in computational and physical volcanology, scientific computer vision, volcanic micro-CT analysis, astronomy, and computational physics."
>
  <PageHeader
    eyebrow="Research"
    title="Research projects"
    description="Current primary direction: computational and physical volcanology. Earlier work spans observational astronomy, experimental physics, and computational mathematics."
  />

  {
    activeProjects.length > 0 && (
      <section class="page-section">
        <h2 class="section-heading">Current research</h2>
        <div class="project-grid">
          {activeProjects.map((project, i) => (
            <EditorialProjectLink
              data={project.data}
              id={project.id}
              href={projectUrl(project.id)}
              index={i + 1}
            />
          ))}
        </div>
      </section>
    )
  }

  {
    completedProjects.length > 0 && (
      <section class="page-section">
        <h2 class="section-heading">Earlier quantitative research</h2>
        <div class="project-list">
          {completedProjects.map((project) => (
            <EditorialProjectLink
              data={project.data}
              id={project.id}
              href={projectUrl(project.id)}
            />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .project-grid {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .project-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
</style>
