---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactLinks from '../components/core/ContactLinks.astro';
import ScientificFigure from '../components/media/ScientificFigure.astro';
import EditorialProjectLink from '../components/projects/EditorialProjectLink.astro';
import { profile } from '../data/profile';
import { getFeaturedProjects } from '../utils/content-queries';
import { projectUrl } from '../utils/site';
import { joel_mauna_loa } from '../data/media';

const activeProjects = (await getFeaturedProjects()).filter(
  (p) => p.data.status === 'active',
);
---

<BaseLayout
  title="About"
  description="About Joel Sotelo Flores, an undergraduate researcher studying physics and earth and environmental geoscience at Washington and Lee University."
>
  <!-- Page opening — editorial layout with portrait -->
  <header class="about-header">
    <div class="about-header__text">
      <p class="about-header__eyebrow">About</p>
      <h1 class="about-header__name">{profile.displayName}</h1>
      <p class="about-header__intro">
        Undergraduate researcher in computational and physical volcanology at Washington
        and Lee University. I build computer-vision and scientific-software workflows
        that turn volcanic imagery and micro-CT data into reproducible quantitative
        measurements.
      </p>
    </div>
    <div class="about-header__portrait">
      <ScientificFigure image={joel_mauna_loa} loading="lazy" />
    </div>
  </header>

  <div class="about-layout">
    <main class="about-main">
      <section class="page-section">
        <h2 class="section-heading">Research focus</h2>
        <ul class="theme-list">
          {
            profile.researchInterests.map((interest) => (
              <li class="theme-list__item">{interest}</li>
            ))
          }
        </ul>
      </section>

      <section class="page-section">
        <h2 class="section-heading">Methodological approach</h2>
        <p class="about-prose">
          My research combines physics and Earth science with scientific imaging,
          machine learning, quantitative analysis, and software development to study
          volcanic systems. This work connects field observation and laboratory data to
          reproducible computational methods that extract physical measurements from
          imagery and micro-CT volumes.
        </p>
        <p class="about-prose">
          Current projects span lava-fountain computer vision and pyroclast micro-CT
          analysis, applying similar end-to-end workflows — collect data, segment
          structures, quantify physical properties — to different volcanic systems.
        </p>
      </section>

      {
        activeProjects.length > 0 && (
          <section class="page-section">
            <h2 class="section-heading">Current work</h2>
            <div class="current-projects">
              {activeProjects.map((p) => (
                <EditorialProjectLink data={p.data} id={p.id} href={projectUrl(p.id)} />
              ))}
            </div>
          </section>
        )
      }

      <section class="page-section">
        <h2 class="section-heading">Contact</h2>
        <p class="about-location">{profile.location}</p>
        <ContactLinks showEmail />
      </section>
    </main>

    <aside class="about-aside">
      <div class="education-card">
        <h2 class="education-card__heading">Education</h2>
        <dl class="education-card__body">
          <div class="education-card__row">
            <dt>Institution</dt>
            <dd>{profile.institution}</dd>
          </div>
          <div class="education-card__row">
            <dt>Degrees</dt>
            <dd>
              <ul class="education-card__list">
                {profile.degrees.map((d) => <li>{d}</li>)}
              </ul>
            </dd>
          </div>
          <div class="education-card__row">
            <dt>Expected</dt>
            <dd>{profile.expectedGraduation}</dd>
          </div>
          <div class="education-card__row">
            <dt>Thesis</dt>
            <dd class="education-card__thesis">
              <em
                >Deep Learning Segmentation of Pyroclastic Micro-CT Volumes for Vesicle,
                Porosity, and Pore-Network Analysis</em
              >
              <span class="education-card__thesis-note">(working title)</span>
            </dd>
          </div>
        </dl>
      </div>
    </aside>
  </div>
</BaseLayout>

<style>
  /* About header */
  .about-header {
    display: grid;
    grid-template-columns: 1fr minmax(400px, 440px);
    gap: var(--space-12);
    align-items: start;
    padding-bottom: var(--space-12);
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-12);
  }

  @media (max-width: 900px) {
    .about-header {
      grid-template-columns: 1fr;
    }
    .about-header__portrait {
      order: -1;
      max-width: 100%;
    }
  }

  .about-header__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-wine);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3);
  }

  .about-header__name {
    font-family: var(--font-display);
    font-size: clamp(2rem, 4vw, 2.75rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.15;
    margin: 0 0 var(--space-6);
    letter-spacing: -0.015em;
  }

  .about-header__intro {
    font-size: 1rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    max-width: 52ch;
    margin: 0;
  }

  /* Main layout */
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 22rem;
    gap: var(--space-12);
    align-items: start;
  }

  @media (max-width: 900px) {
    .about-layout {
      grid-template-columns: 1fr;
    }
    .about-aside {
      order: -1;
    }
  }

  .about-prose {
    font-size: 0.9375rem;
    color: var(--color-text);
    line-height: 1.8;
    max-width: 65ch;
    margin: 0 0 var(--space-4);
  }

  .about-location {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
  }

  /* Theme list */
  .theme-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .theme-list__item {
    font-size: 0.9375rem;
    color: var(--color-text);
    padding: var(--space-3) 0;
    border-bottom: 1px solid var(--color-border);
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .theme-list__item:first-child {
    border-top: 1px solid var(--color-border);
  }

  .theme-list__item::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    background-color: var(--color-wine);
    border-radius: 50%;
    flex-shrink: 0;
  }

  /* Current projects */
  .current-projects {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  /* Education card */
  .education-card {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
    position: sticky;
    top: calc(3.5rem + var(--space-4));
  }

  .education-card__heading {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-6);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .education-card__body {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .education-card__row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: var(--space-2);
    align-items: baseline;
    font-size: 0.8125rem;
  }

  .education-card__row dt {
    color: var(--color-text-muted);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .education-card__row dd {
    color: var(--color-text);
    margin: 0;
  }

  .education-card__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .education-card__thesis {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--color-text);
  }

  .education-card__thesis-note {
    display: block;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-style: normal;
    margin-top: 2px;
  }
</style>
