---
/**
 * Project detail route — scientific case study pages.
 * Generates one static page for every public project using its stable ID.
 * Body is rendered from the verified Markdown content.
 * Related public publications are rendered when relationships exist.
 * Media placements are controlled via projectMedia configuration.
 * No client-side JavaScript.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectContextRail from '../../components/projects/ProjectContextRail.astro';
import PublicationEntry from '../../components/publications/PublicationEntry.astro';
import StatusLabel from '../../components/core/StatusLabel.astro';
import ProjectHeroMedia from '../../components/media/ProjectHeroMedia.astro';
import ScientificImagePair from '../../components/media/ScientificImagePair.astro';
import ScientificVideoPair from '../../components/media/ScientificVideoPair.astro';
import ScientificFigure from '../../components/media/ScientificFigure.astro';
import { getPublicProjects } from '../../utils/content-queries';
import { filterPublic } from '../../utils/content-filter';
import { mediaRegistry, projectMedia } from '../../data/media';
import type {
  ImagePair,
  VideoPair,
  PublicImage,
  DerivedGraphic,
} from '../../types/media';

export async function getStaticPaths() {
  const projects = await getPublicProjects();
  const allPubs = await getCollection('publications');
  const publicPubs = filterPublic(allPubs);

  return projects.map((project) => {
    const relatedPubs = publicPubs.filter((p) =>
      project.data.relatedPublications?.includes(p.id),
    );
    return {
      params: { id: project.id },
      props: { project, relatedPubs },
    };
  });
}

const { project, relatedPubs } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Look up media for this specific project
const mediaMap = projectMedia[project.id];
const heroPair = mediaMap?.heroPair
  ? (mediaRegistry[mediaMap.heroPair] as ImagePair | undefined)
  : undefined;

// Collect all media IDs that will be placed inline
const placedMediaIds = new Set<string>();
if (mediaMap?.mediaPlacements?.afterSection) {
  for (const mediaIds of Object.values(mediaMap.mediaPlacements.afterSection)) {
    for (const id of mediaIds) {
      placedMediaIds.add(id);
    }
  }
}

// Filter remaining media (not hero, not placed inline)
const allImagePairs = (mediaMap?.imagePairs ?? [])
  .map((id) => mediaRegistry[id] as ImagePair | undefined)
  .filter((p): p is ImagePair => p !== undefined && p.kind === 'image-pair');
const allVideoPairs = (mediaMap?.videoPairs ?? [])
  .map((id) => mediaRegistry[id] as VideoPair | undefined)
  .filter((p): p is VideoPair => p !== undefined && p.kind === 'video-pair');
const allScreenshots = (mediaMap?.screenshots ?? [])
  .map((id) => mediaRegistry[id] as PublicImage | undefined)
  .filter((p): p is PublicImage => p !== undefined && p.kind === 'image');
const allFieldImages = (mediaMap?.fieldImages ?? [])
  .map((id) => mediaRegistry[id] as PublicImage | undefined)
  .filter((p): p is PublicImage => p !== undefined && p.kind === 'image');

// Remove hero pair from remaining media
const remainingImagePairs = allImagePairs.filter(
  (p) => p.id !== heroPair?.id && !placedMediaIds.has(p.id),
);
const remainingVideoPairs = allVideoPairs.filter((p) => !placedMediaIds.has(p.id));
const remainingScreenshots = allScreenshots.filter((p) => !placedMediaIds.has(p.id));
const remainingFieldImages = allFieldImages.filter((p) => !placedMediaIds.has(p.id));

const hasRemainingMedia =
  remainingImagePairs.length > 0 ||
  remainingVideoPairs.length > 0 ||
  remainingScreenshots.length > 0 ||
  remainingFieldImages.length > 0;

// Look up derived graphic for this project (if exists)
const derivedGraphic = Object.values(mediaRegistry).find(
  (item): item is DerivedGraphic =>
    item.kind === 'derived-graphic' && item.projectId === project.id,
);

// Project-specific workflow notation
const workflows: Record<string, string[]> = {
  'kilauea-lava-fountain-computer-vision': [
    'Field Video',
    'Labeling',
    'Segmentation',
    'Measurement',
  ],
  'ijen-pyroclast-microct-analysis': [
    'Imaging',
    'Segmentation',
    'Stereometry',
    'Physical Interpretation',
  ],
};
const projectWorkflow = workflows[project.id];
---

<BaseLayout title={data.title} description={data.summary} contentMode="contained">
  <div class="project-page">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/research" class="breadcrumb__link">← Research</a>
    </nav>

    <header class="project-header">
      <div class="project-header__meta">
        <StatusLabel status={data.status} />
      </div>
      <h1 class="project-header__title">{data.title}</h1>
      {data.subtitle && <p class="project-header__subtitle">{data.subtitle}</p>}
      <p class="project-header__summary">{data.summary}</p>
    </header>

    {
      projectWorkflow && (
        <div class="workflow-notation">
          <div class="workflow-notation__items">
            {projectWorkflow.map((stage, i) => (
              <>
                <span class="workflow-notation__stage">{stage}</span>
                {i < projectWorkflow.length - 1 && (
                  <span class="workflow-notation__arrow" aria-hidden="true">
                    →
                  </span>
                )}
              </>
            ))}
          </div>
        </div>
      )
    }

    {
      heroPair && (
        <div class="project-hero">
          <ProjectHeroMedia pair={heroPair} loading="eager" />
        </div>
      )
    }

    <div class="project-layout">
      <aside class="project-sidebar">
        <ProjectContextRail data={data} />
        {
          derivedGraphic && (
            <div class="derived-graphic">
              <img
                src={derivedGraphic.src}
                alt=""
                aria-hidden="true"
                class="derived-graphic__svg"
              />
            </div>
          )
        }
      </aside>

      <div class="project-body">
        <article class="prose">
          <Content />
        </article>

        {
          relatedPubs.length > 0 && (
            <section class="related-section">
              <h2 class="related-section__heading">Related publications</h2>
              <div class="related-section__content">
                {relatedPubs.map((pub) => (
                  <PublicationEntry data={pub.data} />
                ))}
              </div>
            </section>
          )
        }

        {
          hasRemainingMedia && (
            <section class="additional-media-section">
              <h2 class="additional-media-section__heading">Additional media</h2>

              {remainingImagePairs.map((pair) => (
                <div class="media-item">
                  <ScientificImagePair {pair} loading="lazy" />
                </div>
              ))}

              {remainingVideoPairs.map((vp) => (
                <div class="media-item">
                  <ScientificVideoPair pair={vp} />
                </div>
              ))}

              {remainingScreenshots.map((sc) => (
                <div class="media-item">
                  <ScientificFigure image={sc} loading="lazy" />
                </div>
              ))}

              {remainingFieldImages.map((fi) => (
                <div class="media-item media-item--field">
                  <ScientificFigure image={fi} loading="lazy" />
                </div>
              ))}
            </section>
          )
        }
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .project-page {
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: var(--content-padding-inline);
  }

  .breadcrumb {
    margin-bottom: var(--space-8);
  }

  .breadcrumb__link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s ease;
  }

  .breadcrumb__link:hover {
    color: var(--color-wine);
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Project Header                                                  */
  /* ────────────────────────────────────────────────────────────── */

  .project-header {
    margin-bottom: var(--space-12);
  }

  .project-header__meta {
    margin-bottom: var(--space-4);
  }

  .project-header__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.1;
    margin: 0 0 var(--space-4);
    letter-spacing: -0.02em;
  }

  .project-header__subtitle {
    font-size: clamp(1rem, 2vw, 1.125rem);
    color: var(--color-text-muted);
    margin: 0 0 var(--space-5);
    line-height: 1.5;
    max-width: 68ch;
  }

  .project-header__summary {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    max-width: 68ch;
    margin: 0;
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Workflow Notation                                               */
  /* ────────────────────────────────────────────────────────────── */

  .workflow-notation {
    max-width: 68ch;
    margin-bottom: var(--space-12);
  }

  .workflow-notation__items {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4);
    font-family: var(--font-body);
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .workflow-notation__stage {
    color: var(--color-wine);
  }

  .workflow-notation__arrow {
    color: var(--color-text-muted);
    font-size: 0.875rem;
  }

  @media (max-width: 640px) {
    .workflow-notation__items {
      font-size: 0.6875rem;
      gap: var(--space-3);
    }
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Hero Media                                                      */
  /* ────────────────────────────────────────────────────────────── */

  .project-hero {
    margin-bottom: var(--space-16);
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Two-Column Layout                                               */
  /* ────────────────────────────────────────────────────────────── */

  .project-layout {
    display: grid;
    grid-template-columns: 18rem 1fr;
    gap: var(--space-16);
    align-items: start;
  }

  @media (max-width: 1024px) {
    .project-layout {
      grid-template-columns: 16rem 1fr;
      gap: var(--space-10);
    }
  }

  @media (max-width: 900px) {
    .project-layout {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }
  }

  .project-sidebar {
    position: sticky;
    top: calc(3.5rem + var(--space-6));
  }

  @media (max-width: 900px) {
    .project-sidebar {
      position: static;
      order: -1;
      margin-bottom: var(--space-8);
      padding-bottom: var(--space-8);
      border-bottom: 1px solid var(--color-border);
    }
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Derived Graphic — Research Visual Identity                      */
  /* ────────────────────────────────────────────────────────────── */

  .derived-graphic {
    margin-top: var(--space-10);
    opacity: 0.25;
  }

  .derived-graphic__svg {
    display: block;
    width: 100%;
    height: auto;
    max-height: 12rem;
    color: var(--color-wine);
  }

  @media (max-width: 900px) {
    .derived-graphic {
      display: none;
    }
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Prose — Scientific Case Study Typography                        */
  /* ────────────────────────────────────────────────────────────── */

  .prose {
    max-width: 68ch;
  }

  .prose :global(h2) {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.3;
    margin: var(--space-12) 0 var(--space-4);
    letter-spacing: -0.01em;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    font-family: var(--font-body);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.4;
    margin: var(--space-8) 0 var(--space-3);
  }

  .prose :global(p) {
    font-size: 1rem;
    color: var(--color-text);
    line-height: 1.7;
    margin: 0 0 var(--space-5);
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 var(--space-5);
    padding-left: var(--space-6);
  }

  .prose :global(li) {
    margin-bottom: var(--space-2);
    line-height: 1.7;
  }

  .prose :global(strong) {
    font-weight: 600;
    color: var(--color-text);
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.875em;
    background-color: rgba(223, 213, 216, 0.3);
    padding: 0.125em 0.25em;
    border-radius: 2px;
  }

  .prose :global(a) {
    color: var(--color-wine);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 2px;
    transition: color 0.2s ease;
  }

  .prose :global(a:hover) {
    color: var(--color-accent-hover);
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Related Publications                                            */
  /* ────────────────────────────────────────────────────────────── */

  .related-section {
    margin-top: var(--space-16);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .related-section__heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-6);
  }

  .related-section__content {
    max-width: 68ch;
  }

  /* ────────────────────────────────────────────────────────────── */
  /* Additional Media                                                */
  /* ────────────────────────────────────────────────────────────── */

  .additional-media-section {
    margin-top: var(--space-16);
    padding-top: var(--space-10);
    border-top: 1px solid var(--color-border);
  }

  .additional-media-section__heading {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-10);
  }

  .media-item {
    margin-bottom: var(--space-12);
  }

  .media-item--field {
    max-width: 600px;
  }
</style>
