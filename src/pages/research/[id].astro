---
/**
 * Project detail route.
 * Generates one static page for every public project using its stable ID.
 * Body is rendered from the verified Markdown content.
 * Related public publications are rendered when relationships exist.
 * No client-side JavaScript.
 */
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMeta from '../../components/projects/ProjectMeta.astro';
import PublicationEntry from '../../components/publications/PublicationEntry.astro';
import StatusLabel from '../../components/core/StatusLabel.astro';
import ProjectHeroMedia from '../../components/media/ProjectHeroMedia.astro';
import ScientificImagePair from '../../components/media/ScientificImagePair.astro';
import ScientificVideoPair from '../../components/media/ScientificVideoPair.astro';
import ScientificFigure from '../../components/media/ScientificFigure.astro';
import { getPublicProjects } from '../../utils/content-queries';
import { filterPublic } from '../../utils/content-filter';
import { mediaRegistry, projectMedia } from '../../data/media';
import type { ImagePair, VideoPair, PublicImage } from '../../types/media';

export async function getStaticPaths() {
  const projects = await getPublicProjects();
  const allPubs = await getCollection('publications');
  const publicPubs = filterPublic(allPubs);

  return projects.map((project) => {
    const relatedPubs = publicPubs.filter((p) =>
      project.data.relatedPublications?.includes(p.id),
    );
    return {
      params: { id: project.id },
      props: { project, relatedPubs },
    };
  });
}

const { project, relatedPubs } = Astro.props;
const { data } = project;
const { Content } = await render(project);

// Look up media for this specific project
const mediaMap = projectMedia[project.id];
const heroPair = mediaMap?.heroPair
  ? (mediaRegistry[mediaMap.heroPair] as ImagePair | undefined)
  : undefined;
const imagePairs = (mediaMap?.imagePairs ?? [])
  .map((id) => mediaRegistry[id] as ImagePair | undefined)
  .filter((p): p is ImagePair => p !== undefined && p.kind === 'image-pair');
const videoPairs = (mediaMap?.videoPairs ?? [])
  .map((id) => mediaRegistry[id] as VideoPair | undefined)
  .filter((p): p is VideoPair => p !== undefined && p.kind === 'video-pair');
const screenshots = (mediaMap?.screenshots ?? [])
  .map((id) => mediaRegistry[id] as PublicImage | undefined)
  .filter((p): p is PublicImage => p !== undefined && p.kind === 'image');
const fieldImages = (mediaMap?.fieldImages ?? [])
  .map((id) => mediaRegistry[id] as PublicImage | undefined)
  .filter((p): p is PublicImage => p !== undefined && p.kind === 'image');
---

<BaseLayout title={data.title} description={data.summary}>
  <nav class="breadcrumb" aria-label="Breadcrumb">
    <a href="/research" class="breadcrumb__link">← Research</a>
  </nav>

  <header class="project-header">
    <div class="project-header__status">
      <StatusLabel status={data.status} />
    </div>
    <h1 class="project-header__title">{data.title}</h1>
    <p class="project-header__subtitle">{data.subtitle}</p>
    <p class="project-header__summary">{data.summary}</p>
  </header>

  {heroPair && <ProjectHeroMedia pair={heroPair} loading="eager" />}

  <div class="project-layout">
    <aside class="project-sidebar">
      <ProjectMeta data={data} />
    </aside>

    <div class="project-body">
      <div class="prose">
        <Content />
      </div>

      {
        relatedPubs.length > 0 && (
          <section class="related-outputs">
            <h2 class="related-outputs__heading">Related publications</h2>
            {relatedPubs.map((pub) => (
              <PublicationEntry data={pub.data} />
            ))}
          </section>
        )
      }

      {
        (imagePairs.length > 1 ||
          videoPairs.length > 0 ||
          screenshots.length > 0 ||
          fieldImages.length > 0) && (
          <section class="project-media-section">
            <h2 class="project-media-section__heading">Media</h2>

            {imagePairs.slice(1).map((pair) => (
              <div class="project-media-item">
                <ScientificImagePair {pair} loading="lazy" />
              </div>
            ))}

            {videoPairs.map((vp) => (
              <div class="project-media-item">
                <ScientificVideoPair pair={vp} />
              </div>
            ))}

            {screenshots.map((sc) => (
              <div class="project-media-item">
                <ScientificFigure image={sc} loading="lazy" />
              </div>
            ))}

            {fieldImages.map((fi) => (
              <div class="project-media-item project-media-item--field">
                <ScientificFigure image={fi} loading="lazy" />
              </div>
            ))}
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .breadcrumb {
    margin-bottom: var(--space-8);
  }

  .breadcrumb__link {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-weight: 500;
  }

  .breadcrumb__link:hover {
    color: var(--color-wine);
  }

  .project-header {
    margin-bottom: var(--space-10);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--color-border);
  }

  .project-header__status {
    margin-bottom: var(--space-3);
  }

  .project-header__title {
    font-family: var(--font-display);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.15;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.015em;
  }

  .project-header__subtitle {
    font-size: 1.0625rem;
    color: var(--color-text-muted);
    margin: 0 0 var(--space-4);
    line-height: 1.5;
  }

  .project-header__summary {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    max-width: 68ch;
    margin: 0;
  }

  .project-layout {
    display: grid;
    grid-template-columns: 22rem 1fr;
    gap: var(--space-12);
    align-items: start;
  }

  @media (max-width: 900px) {
    .project-layout {
      grid-template-columns: 1fr;
    }
    .project-sidebar {
      order: 1;
    }
    .project-body {
      order: 0;
    }
  }

  .project-sidebar {
    position: sticky;
    top: calc(3.5rem + var(--space-4));
  }

  .related-outputs {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .related-outputs__heading {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-4);
  }

  .project-media-section {
    margin-top: var(--space-12);
    padding-top: var(--space-8);
    border-top: 1px solid var(--color-border);
  }

  .project-media-section__heading {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-8);
    padding-bottom: var(--space-3);
    border-bottom: 1px solid var(--color-border);
  }

  .project-media-item {
    margin-bottom: var(--space-10);
  }

  .project-media-item--field {
    max-width: 600px;
  }
</style>
