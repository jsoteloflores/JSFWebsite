---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/core/PageHeader.astro';
import StatusLabel from '../components/core/StatusLabel.astro';
import { researchSoftware } from '../data/scholarly-output';
---

<BaseLayout
  title="Software"
  description="Scientific software developed for physical and computational volcanology research."
>
  <PageHeader
    eyebrow="Software"
    title="Software"
    description="Scientific software developed for image-based analysis in physical and computational volcanology."
  />

  <!-- Research Software -->
  {
    researchSoftware.length > 0 && (
      <section class="sw-section">
        <div class="sw-list">
          {researchSoftware.map((software) => (
            <div class="sw-entry">
              <div class="sw-entry__header">
                <h2 class="sw-entry__name">{software.name}</h2>
                <StatusLabel status="private" />
              </div>
              <p class="sw-entry__description">{software.description}</p>
              {software.projectId && (
                <a href={`/research/${software.projectId}`} class="sw-entry__link">
                  Related research →
                </a>
              )}
            </div>
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .sw-section {
    max-width: 75ch;
    margin-inline: auto;
  }

  .sw-list {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  .sw-entry {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    background: var(--color-basalt);
  }

  .sw-entry__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .sw-entry__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0;
  }

  .sw-entry__description {
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
    margin: 0;
  }

  .sw-entry__link {
    font-size: 0.875rem;
    color: var(--color-wine);
    text-decoration: none;
    transition: color 0.2s;
    width: fit-content;
  }

  .sw-entry__link:hover {
    color: var(--color-oxidized-red);
  }

  .sw-entry__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  @media (max-width: 768px) {
    .sw-entry {
      padding: 1.25rem;
    }

    .sw-entry__header {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
