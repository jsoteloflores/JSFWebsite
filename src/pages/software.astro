---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/core/PageHeader.astro';
import SoftwareEntry from '../components/software/SoftwareEntry.astro';
import ContentNotice from '../components/core/ContentNotice.astro';
import { getPublicSoftware } from '../utils/content-queries';

const software = await getPublicSoftware();
---

<BaseLayout
  title="Software"
  description="Scientific software and research tools developed by Joel Sotelo Flores."
>
  <PageHeader
    eyebrow="Software"
    title="Scientific software"
    description="Software is central to the research workflow. Public records are being withheld until canonical names, repository visibility, and implemented capabilities are confirmed."
  />

  {
    software.length > 0 ? (
      <section class="page-section">
        {software.map((sw) => (
          <SoftwareEntry data={sw.data} />
        ))}
      </section>
    ) : (
      <ContentNotice message="Public software records are being prepared. Canonical names, repository visibility, DOI and release metadata, and accurate capability descriptions are being verified before entry." />
    )
  }

  <section class="page-section">
    <h2 class="section-heading">Research context</h2>
    <p class="software-context">
      Current work includes lava-fountain segmentation and labeling workflows and
      pyroclast stereometric analysis software. These tools support current research
      workflows; their public names, repository access, release metadata, and
      documentation are still being finalized.
    </p>
    <ul class="software-links">
      <li>
        <a href="/research/kilauea-lava-fountain-computer-vision"
          >Kīlauea lava-fountain computer vision →</a
        >
      </li>
      <li>
        <a href="/research/ijen-pyroclast-microct-analysis"
          >Ijen pyroclast micro-CT analysis →</a
        >
      </li>
    </ul>
  </section>
</BaseLayout>

<style>
  .software-context {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 65ch;
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .software-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }
  .software-links a {
    font-size: 0.9375rem;
  }
</style>
