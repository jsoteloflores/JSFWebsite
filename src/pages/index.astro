---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/publications/PublicationEntry.astro';
import ContactLinks from '../components/core/ContactLinks.astro';
import ScientificImagePair from '../components/media/ScientificImagePair.astro';
import ScientificFigure from '../components/media/ScientificFigure.astro';
import EditorialProjectLink from '../components/projects/EditorialProjectLink.astro';
import { profile } from '../data/profile';
import { getFeaturedProjects, getPublicPublications } from '../utils/content-queries';
import { projectUrl } from '../utils/site';
import { kilauea_daytime_pair, joel_kilauea_portrait } from '../data/media';

const featuredProjects = await getFeaturedProjects();
const kilauea = featuredProjects.find(
  (p) => p.id === 'kilauea-lava-fountain-computer-vision',
);
const ijen = featuredProjects.find((p) => p.id === 'ijen-pyroclast-microct-analysis');
const publications = await getPublicPublications();
const selectedPublication = publications[0];
---

<BaseLayout
  title="Computational Volcanology"
  description=`${profile.displayName} — computational and physical volcanology researcher at Washington and Lee University.`
>
  <!-- 1. Night-sky banner with identity overlay -->
  <section class="banner" data-section="hero">
    <div class="banner__bg"></div>
    <div class="banner__overlay"></div>
    <div class="banner__content content-wrapper">
      <p class="banner__eyebrow">Computational &amp; Physical Volcanology</p>
      <h1 class="banner__name">{profile.displayName}</h1>
      <p class="banner__statement">
        I develop computer-vision and scientific-software workflows that turn volcanic
        imagery and micro-CT data into quantitative measurements of eruptive processes
        and pyroclast structure.
      </p>
      <ul class="banner__meta" aria-label="Academic details">
        <li>{profile.institution}</li>
        <li>B.S. Physics</li>
        <li>B.S. Earth and Environmental Geoscience</li>
        <li>Expected June 2027</li>
        <li>{profile.location}</li>
      </ul>
      <div class="banner__actions">
        <a href="/research" class="banner__btn banner__btn--primary">Explore Research</a
        >
        <a href="/about" class="banner__btn banner__btn--secondary">About Joel</a>
      </div>
    </div>
  </section>

  <!-- 2. Scientific transformation: observation → segmentation -->
  <section class="primary-figure page-section" data-section="primary-figure">
    <p class="primary-figure__eyebrow">Observation → Segmentation</p>
    <div class="primary-figure__panel">
      <ScientificImagePair pair={kilauea_daytime_pair} loading="eager" />
    </div>
  </section>

  <!-- 3 & 4. Featured research — Kīlauea + Ijen -->
  {
    kilauea && (
      <section class="page-section" data-section="featured-kilauea">
        <EditorialProjectLink
          data={kilauea.data}
          id={kilauea.id}
          href={projectUrl(kilauea.id)}
          index={1}
        />
      </section>
    )
  }

  {
    ijen && (
      <section class="page-section" data-section="featured-ijen">
        <EditorialProjectLink
          data={ijen.data}
          id={ijen.id}
          href={projectUrl(ijen.id)}
          index={2}
        />
      </section>
    )
  }

  <!-- 5. Research approach -->
  <section class="approach page-section" data-section="approach">
    <h2 class="section-heading">Research approach</h2>
    <ol class="approach__list">
      <li class="approach__step">
        <span class="approach__num">01</span>
        <div class="approach__content">
          <h3 class="approach__title">Observe</h3>
          <p class="approach__body">
            Field footage, scientific imagery, micro-CT volumes, and laboratory
            measurements provide the raw record of physical systems.
          </p>
        </div>
      </li>
      <li class="approach__step">
        <span class="approach__num">02</span>
        <div class="approach__content">
          <h3 class="approach__title">Segment</h3>
          <p class="approach__body">
            Computer vision and machine-learning workflows identify structures of
            interest consistently across complex, variable-condition imagery.
          </p>
        </div>
      </li>
      <li class="approach__step">
        <span class="approach__num">03</span>
        <div class="approach__content">
          <h3 class="approach__title">Quantify</h3>
          <p class="approach__body">
            Scientific software converts segmented imagery into reproducible
            measurements of geometry, texture, pore structure, and physical behavior.
          </p>
        </div>
      </li>
    </ol>
  </section>

  <!-- 6. About preview with one field image -->
  <section class="about-preview page-section" data-section="about-preview">
    <div class="about-preview__inner">
      <div class="about-preview__image">
        <ScientificFigure image={joel_kilauea_portrait} loading="lazy" />
      </div>
      <div class="about-preview__text">
        <p class="about-preview__label">About Joel</p>
        <h2 class="about-preview__heading">Field research and computation</h2>
        <p class="about-preview__body">
          An undergraduate researcher combining physics, Earth science, and machine
          learning to build scientific-software workflows for volcanology research.
        </p>
        <a href="/about" class="about-preview__link">Read about Joel →</a>
      </div>
    </div>
  </section>

  <!-- 7. Selected publication -->
  {
    selectedPublication && (
      <section class="page-section" data-section="selected-publication">
        <h2 class="section-heading">Selected publication</h2>
        <p class="section-context">
          Joel's published research spans quantitative scientific domains.
        </p>
        <PublicationEntry data={selectedPublication.data} />
        <p class="section-more">
          <a href="/publications">All publications →</a>
        </p>
      </section>
    )
  }

  <!-- 8. Contact -->
  <section class="page-section" data-section="contact">
    <h2 class="section-heading">Get in touch</h2>
    <p class="contact-statement">
      Questions about computational volcanology, scientific image analysis, or research
      software are welcome.
    </p>
    <ContactLinks showEmail />
  </section>
</BaseLayout>

<style>
  /* ================================================ */
  /* Night-sky banner                                 */
  /* ================================================ */

  .banner {
    position: relative;
    min-height: 580px;
    display: flex;
    align-items: center;
    margin-bottom: var(--space-16);
    overflow: hidden;
  }

  @media (max-width: 768px) {
    .banner {
      min-height: 480px;
    }
  }

  @media (max-width: 375px) {
    .banner {
      min-height: 420px;
    }
  }

  .banner__bg {
    position: absolute;
    inset: 0;
    background-image: url('/media/home/nightsky-banner.webp');
    background-size: cover;
    background-position: 65% center;
    z-index: 0;
  }

  @media (max-width: 600px) {
    .banner__bg {
      background-position: 75% center;
    }
  }

  .banner__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(20, 7, 9, 0.88) 0%,
      rgba(20, 7, 9, 0.7) 40%,
      rgba(20, 7, 9, 0.18) 75%,
      rgba(20, 7, 9, 0) 100%
    );
    z-index: 1;
  }

  @media (max-width: 600px) {
    .banner__overlay {
      background: rgba(20, 7, 9, 0.72);
    }
  }

  .banner__content {
    position: relative;
    z-index: 2;
    padding-block: var(--space-16);
    max-width: 54ch;
  }

  .banner__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-surface-soft);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
  }

  .banner__name {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 5.5vw, 3.75rem);
    font-weight: 600;
    color: #f6f2f3;
    line-height: 1.1;
    margin: 0 0 var(--space-5);
    letter-spacing: -0.02em;
  }

  .banner__statement {
    font-size: clamp(0.9375rem, 1.8vw, 1.0625rem);
    color: #e8e0e2;
    line-height: 1.7;
    max-width: 50ch;
    margin: 0 0 var(--space-6);
  }

  .banner__meta {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-8);
    font-size: 0.8125rem;
    color: var(--color-surface-soft);
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .banner__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: center;
  }

  .banner__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    transition:
      background-color var(--transition-duration) var(--transition-easing),
      border-color var(--transition-duration) var(--transition-easing),
      box-shadow var(--transition-duration) var(--transition-easing);
  }

  .banner__btn--primary {
    background-color: var(--color-wine);
    border: 1.5px solid var(--color-wine);
    color: #ffffff;
  }

  .banner__btn--primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: #ffffff;
    box-shadow: 0 2px 8px rgba(182, 58, 70, 0.4);
  }

  .banner__btn--secondary {
    background-color: rgba(246, 242, 243, 0.12);
    border: 1.5px solid rgba(246, 242, 243, 0.45);
    color: #f6f2f3;
    backdrop-filter: blur(2px);
  }

  .banner__btn--secondary:hover {
    background-color: rgba(246, 242, 243, 0.22);
    border-color: rgba(246, 242, 243, 0.7);
    color: #ffffff;
  }

  /* Primary figure */
  .primary-figure {
    margin-bottom: var(--space-16);
  }

  .primary-figure__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-wine);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
  }

  .primary-figure__panel {
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  /* Research approach */
  .approach__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .approach__step {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: var(--space-4);
    align-items: start;
    padding-block: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .approach__step:last-child {
    border-bottom: 1px solid var(--color-border);
  }

  .approach__num {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-wine);
    letter-spacing: 0.05em;
    padding-top: 0.25rem;
  }

  .approach__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-2);
  }

  .approach__body {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
    max-width: 55ch;
  }

  /* About preview */
  .about-preview__inner {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: var(--space-10);
    align-items: center;
    background-color: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-8);
    overflow: hidden;
  }

  @media (max-width: 700px) {
    .about-preview__inner {
      grid-template-columns: 1fr;
    }
  }

  .about-preview__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-wine);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-2);
  }

  .about-preview__heading {
    font-family: var(--font-display);
    font-size: 1.375rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-4);
    line-height: 1.3;
  }

  .about-preview__body {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }

  .about-preview__link {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--color-wine);
    text-decoration: none;
  }

  .about-preview__link:hover {
    color: var(--color-accent-hover);
  }

  /* Section helpers */
  .section-context {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin: calc(-1 * var(--space-4)) 0 var(--space-6);
  }

  .section-more {
    margin-top: var(--space-6);
    font-size: 0.875rem;
  }

  .contact-statement {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 55ch;
    margin: 0 0 var(--space-6);
  }
</style>
