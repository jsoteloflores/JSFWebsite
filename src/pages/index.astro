---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/publications/PublicationEntry.astro';
import ContactLinks from '../components/core/ContactLinks.astro';
import ScientificImagePair from '../components/media/ScientificImagePair.astro';
import { profile } from '../data/profile';
import { getFeaturedProjects, getPublicPublications } from '../utils/content-queries';
import { projectUrl } from '../utils/site';
import { kilauea_daytime_pair, ijen_sem_pair } from '../data/media';

const featuredProjects = await getFeaturedProjects();
const kilauea = featuredProjects.find(
  (p) => p.id === 'kilauea-lava-fountain-computer-vision',
);
const ijen = featuredProjects.find((p) => p.id === 'ijen-pyroclast-microct-analysis');
const publications = await getPublicPublications();
const selectedPublication = publications[0];
---

<BaseLayout
  title="Computational Volcanology"
  description=`${profile.displayName} — computational and physical volcanology researcher at Washington and Lee University.`
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero__text">
      <p class="hero__eyebrow">Computational &amp; Physical Volcanology</p>
      <h1 class="hero__heading">{profile.displayName}</h1>
      <p class="hero__statement">
        I develop computer-vision and scientific-software workflows that turn volcanic
        imagery and micro-CT data into quantitative measurements of eruptive processes
        and pyroclast structure.
      </p>
      <ul class="hero__meta" aria-label="Academic details">
        <li>{profile.institution}</li>
        <li>B.S. Physics</li>
        <li>B.S. Earth and Environmental Geoscience</li>
        <li>Expected June 2027</li>
        <li>{profile.location}</li>
      </ul>
      <div class="hero__ctas">
        <a href="/research" class="hero__cta hero__cta--primary">Explore research</a>
        <a href="/about" class="hero__cta">About Joel</a>
        <a
          href={`mailto:${profile.academicEmail}`}
          class="hero__cta hero__cta--contact"
        >
          Get in touch
        </a>
      </div>
    </div>
    <div class="hero__media">
      <ScientificImagePair pair={kilauea_daytime_pair} loading="eager" />
    </div>
  </section>

  <!-- Featured projects -->
  {
    kilauea && (
      <section class="page-section feature-section">
        <div class="feature-section__media">
          <ScientificImagePair pair={kilauea_daytime_pair} loading="lazy" />
        </div>
        <div class="feature-section__content">
          <h2 class="feature-section__title">
            <a href={projectUrl(kilauea.id)} class="feature-section__link">
              {kilauea.data.title}
            </a>
          </h2>
          <p class="feature-section__summary">{kilauea.data.summary}</p>
          <ul class="feature-section__themes">
            {kilauea.data.researchThemes.slice(0, 3).map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          <a href={projectUrl(kilauea.id)} class="feature-section__cta">
            View project →
          </a>
        </div>
      </section>
    )
  }

  {
    ijen && (
      <section class="page-section feature-section feature-section--reverse">
        <div class="feature-section__media">
          <ScientificImagePair pair={ijen_sem_pair} loading="lazy" />
        </div>
        <div class="feature-section__content">
          <h2 class="feature-section__title">
            <a href={projectUrl(ijen.id)} class="feature-section__link">
              {ijen.data.title}
            </a>
          </h2>
          <p class="feature-section__summary">{ijen.data.summary}</p>
          <ul class="feature-section__themes">
            {ijen.data.researchThemes.slice(0, 3).map((t) => (
              <li>{t}</li>
            ))}
          </ul>
          <a href={projectUrl(ijen.id)} class="feature-section__cta">
            View project →
          </a>
        </div>
      </section>
    )
  }

  <!-- Research approach -->
  <section class="page-section">
    <h2 class="section-heading">Research approach</h2>
    <div class="approach-grid">
      <div class="approach-stage">
        <p class="approach-stage__number" aria-hidden="true">01</p>
        <h3 class="approach-stage__title">Observe</h3>
        <p class="approach-stage__body">
          Field footage, scientific imagery, micro-CT volumes, and laboratory
          measurements provide the raw record of physical systems.
        </p>
      </div>
      <div class="approach-stage">
        <p class="approach-stage__number" aria-hidden="true">02</p>
        <h3 class="approach-stage__title">Segment</h3>
        <p class="approach-stage__body">
          Computer vision and machine-learning workflows identify structures of interest
          consistently across complex, variable-condition imagery.
        </p>
      </div>
      <div class="approach-stage">
        <p class="approach-stage__number" aria-hidden="true">03</p>
        <h3 class="approach-stage__title">Quantify</h3>
        <p class="approach-stage__body">
          Scientific software converts segmented imagery into reproducible measurements
          of geometry, texture, pore structure, and physical behavior.
        </p>
      </div>
    </div>
  </section>

  <!-- Selected publication -->
  {
    selectedPublication && (
      <section class="page-section">
        <h2 class="section-heading">Selected publication</h2>
        <p class="section-context">
          Joel's published research spans multiple quantitative scientific domains.
        </p>
        <PublicationEntry data={selectedPublication.data} />
        <p class="section-more">
          <a href="/publications">All publications →</a>
        </p>
      </section>
    )
  }

  <!-- Contact -->
  <section class="page-section">
    <h2 class="section-heading">Get in touch</h2>
    <p class="contact-statement">
      Questions about computational volcanology, scientific image analysis, or research
      software are welcome.
    </p>
    <ContactLinks showEmail />
  </section>
</BaseLayout>

<style>
  /* Hero layout */
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-12);
    align-items: start;
    padding-block: var(--space-12) var(--space-12);
    border-bottom: 1px solid var(--color-charcoal);
    margin-bottom: var(--space-16);
  }

  @media (max-width: 800px) {
    .hero {
      grid-template-columns: 1fr;
    }
    .hero__media {
      order: -1;
    }
  }

  .hero__eyebrow {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-sandstone);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-4);
  }
  .hero__heading {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 600;
    color: var(--color-ivory);
    line-height: 1.1;
    margin: 0 0 var(--space-6);
    letter-spacing: -0.01em;
  }
  .hero__statement {
    font-size: 1rem;
    color: var(--color-ash);
    line-height: 1.7;
    max-width: 50ch;
    margin: 0 0 var(--space-6);
  }
  .hero__meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
    list-style: none;
    margin: 0 0 var(--space-8);
    padding: 0;
    font-size: 0.8125rem;
    color: var(--color-muted-text);
  }
  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }
  .hero__cta {
    display: inline-block;
    font-size: 0.9375rem;
    text-decoration: none;
    padding: var(--space-2) var(--space-5);
    border: 1px solid var(--color-stone);
    border-radius: var(--radius-sm);
    color: var(--color-ash);
    transition:
      border-color var(--transition-duration),
      color var(--transition-duration);
  }
  .hero__cta:hover {
    border-color: var(--color-sandstone);
    color: var(--color-ivory);
    text-decoration: none;
  }
  .hero__cta--primary {
    background-color: var(--color-wine);
    border-color: var(--color-wine);
    color: var(--color-ivory);
  }
  .hero__cta--primary:hover {
    background-color: var(--color-oxidized-red);
    border-color: var(--color-oxidized-red);
  }
  .hero__cta--contact {
    font-size: 0.875rem;
    color: var(--color-muted-text);
  }

  /* Feature sections */
  .feature-section {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-10);
    align-items: start;
    padding-block: var(--space-8);
    border-top: 1px solid var(--color-charcoal);
  }

  .feature-section--reverse .feature-section__media {
    order: 1;
  }
  .feature-section--reverse .feature-section__content {
    order: 0;
  }

  @media (max-width: 800px) {
    .feature-section {
      grid-template-columns: 1fr;
    }
    .feature-section--reverse .feature-section__media {
      order: 0;
    }
  }

  .feature-section__title {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-ivory);
    margin: 0 0 var(--space-4);
    line-height: 1.3;
  }
  .feature-section__link {
    color: inherit;
    text-decoration: none;
  }
  .feature-section__link:hover {
    color: var(--color-sandstone);
  }
  .feature-section__summary {
    font-size: 0.9375rem;
    color: var(--color-ash);
    line-height: 1.7;
    margin: 0 0 var(--space-4);
  }
  .feature-section__themes {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }
  .feature-section__themes li {
    font-size: 0.75rem;
    font-family: var(--font-mono);
    color: var(--color-stone);
    border: 1px solid var(--color-charcoal);
    padding: 1px var(--space-2);
    border-radius: var(--radius-sm);
  }
  .feature-section__cta {
    font-size: 0.875rem;
    color: var(--color-sandstone);
    text-decoration: none;
  }
  .feature-section__cta:hover {
    color: var(--color-ivory);
  }

  /* Research approach */
  .approach-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-8);
  }
  @media (max-width: 700px) {
    .approach-grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
    }
  }
  .approach-stage {
    border-top: 2px solid var(--color-charcoal);
    padding-top: var(--space-4);
  }
  .approach-stage__number {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-muted-text);
    margin: 0 0 var(--space-3);
  }
  .approach-stage__title {
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-ivory);
    margin: 0 0 var(--space-3);
  }
  .approach-stage__body {
    font-size: 0.875rem;
    color: var(--color-ash);
    line-height: 1.7;
    margin: 0;
  }
  .section-context {
    font-size: 0.875rem;
    color: var(--color-muted-text);
    margin: calc(-1 * var(--space-4)) 0 var(--space-6);
  }
  .section-more {
    margin-top: var(--space-6);
    font-size: 0.875rem;
  }
  .contact-statement {
    font-size: 0.9375rem;
    color: var(--color-ash);
    max-width: 55ch;
    margin: 0 0 var(--space-6);
  }
</style>
