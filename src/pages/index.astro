---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationEntry from '../components/publications/PublicationEntry.astro';
import ContactLinks from '../components/core/ContactLinks.astro';
import ScientificFigure from '../components/media/ScientificFigure.astro';
import FeaturedResearchStory from '../components/projects/FeaturedResearchStory.astro';
import { profile } from '../data/profile';
import { getFeaturedProjects, getPublicPublications } from '../utils/content-queries';
import { projectUrl } from '../utils/site';
import {
  kilauea_daytime_pair,
  ijen_sem_pair,
  joel_kilauea_portrait,
} from '../data/media';

const featuredProjects = await getFeaturedProjects();
const kilauea = featuredProjects.find(
  (p) => p.id === 'kilauea-lava-fountain-computer-vision',
);
const ijen = featuredProjects.find((p) => p.id === 'ijen-pyroclast-microct-analysis');
const publications = await getPublicPublications();
const selectedPublication = publications[0];
---

<BaseLayout
  title="Joel Sotelo Flores | Computational & Physical Volcanology"
  description="Joel Sotelo Flores is an undergraduate researcher in computational and physical volcanology working with computer vision, scientific software, volcanic imagery, and quantitative image analysis."
  contentMode="fluid"
  includeStructuredData={true}
>
  <!-- ===== 1. FULL-BLEED SUNSET HERO ===== -->
  <section class="hero layout-full" data-section="hero">
    <div class="hero__bg"></div>
    <div class="hero__overlay"></div>
    <div class="hero__content layout-wide">
      <h1 class="hero__name">{profile.displayName}</h1>
      <p class="hero__discipline">Computational &amp; Physical Volcanology</p>
      <p class="hero__statement">
        I use computer vision and scientific software to extract quantitative
        measurements from volcanic imagery and micro-CT data, with interests in eruption
        dynamics, pyroclast textures, and image-based analysis.
      </p>
      <div class="hero__meta" aria-label="Academic details">
        <p>{profile.institution}</p>
        <p>B.S. Physics · B.S. Earth and Environmental Geoscience</p>
        <p>Expected June 2027 · {profile.location}</p>
      </div>
      <div class="hero__actions">
        <a href="/research" class="hero__btn hero__btn--primary">Explore Research</a>
        <a href="/about" class="hero__btn hero__btn--secondary">About Joel</a>
      </div>
    </div>
  </section>

  <!-- ===== 2. CURRENT RESEARCH SECTION ===== -->
  <div class="research-section" data-section="current-research">
    <div class="layout-wide">
      <p class="research-section__label">Current Research</p>
    </div>

    <!-- Kīlauea Featured Research -->
    {
      kilauea && (
        <section class="layout-wide research-feature">
          <FeaturedResearchStory
            index={1}
            data={kilauea.data}
            href={projectUrl(kilauea.id)}
            pair={kilauea_daytime_pair}
            orientation="media-first"
          />
        </section>
      )
    }

    <!-- Ijen Featured Research (reversed) -->
    {
      ijen && (
        <section class="layout-wide research-feature">
          <FeaturedResearchStory
            index={2}
            data={ijen.data}
            href={projectUrl(ijen.id)}
            pair={ijen_sem_pair}
            orientation="text-first"
          />
        </section>
      )
    }
  </div>

  <!-- ===== 3. RESEARCH INTERESTS ===== -->
  <section class="interests-section" data-section="research-interests">
    <div class="layout-wide">
      <h2 class="interests-section__heading">Research interests</h2>
      <div class="interests-grid">
        <div class="interest-item">
          <h3 class="interest-item__title">Eruption dynamics</h3>
          <p class="interest-item__body">
            Quantitative analysis of eruptive behavior using field observations, video,
            and image-derived measurements.
          </p>
        </div>
        <div class="interest-item">
          <h3 class="interest-item__title">Scientific computer vision</h3>
          <p class="interest-item__body">
            Segmentation and temporal analysis of geoscientific imagery, particularly
            under variable observational conditions.
          </p>
        </div>
        <div class="interest-divider" aria-hidden="true"></div>
        <div class="interest-item">
          <h3 class="interest-item__title">
            Pyroclast textures and transport properties
          </h3>
          <p class="interest-item__body">
            Using micro-CT, microscopy, stereology, and pore-network analysis to connect
            volcanic textures with physical processes.
          </p>
        </div>
        <div class="interest-item">
          <h3 class="interest-item__title">Reproducible computational methods</h3>
          <p class="interest-item__body">
            Developing scientific software and analysis workflows that make image-based
            measurements more consistent and scalable.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== 4. ABOUT PREVIEW — editorial, no card border ===== -->
  <section class="about-preview" data-section="about-preview">
    <div class="layout-wide about-preview__inner">
      <div class="about-preview__image">
        <ScientificFigure image={joel_kilauea_portrait} loading="lazy" />
      </div>
      <div class="about-preview__text">
        <p class="about-preview__label">About</p>
        <h2 class="about-preview__heading">
          From field observations<br />to quantitative analysis
        </h2>
        <p class="about-preview__body">
          My current work focuses on computational approaches to physical volcanology,
          particularly computer vision for eruption imagery and quantitative analysis of
          pyroclast textures.
        </p>
        <a href="/about" class="about-preview__link">About →</a>
      </div>
    </div>
  </section>

  <!-- ===== 5. PUBLICATION — reading width ===== -->
  {
    selectedPublication && (
      <section class="pub-section" data-section="selected-publication">
        <div class="layout-reading">
          <h2 class="section-heading">Publication</h2>
          <PublicationEntry data={selectedPublication.data} />
          <p class="section-more">
            <a href="/publications">All publications →</a>
          </p>
        </div>
      </section>
    )
  }

  <!-- ===== 6. CONTACT ===== -->
  <section class="contact-section" data-section="contact">
    <div class="layout-content">
      <h2 class="section-heading">Get in touch</h2>
      <p class="contact-statement">
        Questions about computational volcanology, scientific image analysis, or
        research software are welcome.
      </p>
      <ContactLinks showEmail />
    </div>
  </section>
</BaseLayout>

<style>
  /* ─── Hero ─────────────────────────────────────────────────── */
  .hero {
    position: relative;
    min-height: clamp(560px, 72vh, 820px);
    display: flex;
    align-items: center;
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    background-image: url('/media/home/kilauea-sunset-hero.webp');
    background-size: cover;
    background-position: center 55%;
    z-index: 0;
  }

  @media (max-width: 600px) {
    .hero__bg {
      background-position: center 60%;
    }
  }

  .hero__overlay {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(39, 12, 15, 0.82) 0%,
        rgba(39, 12, 15, 0.58) 38%,
        rgba(39, 12, 15, 0.18) 65%,
        rgba(39, 12, 15, 0) 100%
      ),
      linear-gradient(0deg, rgba(39, 12, 15, 0.35) 0%, rgba(39, 12, 15, 0) 35%);
    z-index: 1;
  }

  @media (max-width: 600px) {
    .hero__overlay {
      background: linear-gradient(
        0deg,
        rgba(39, 12, 15, 0.82) 0%,
        rgba(39, 12, 15, 0.6) 50%,
        rgba(39, 12, 15, 0.2) 100%
      );
    }
  }

  .hero__content {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: var(--width-wide);
  }

  .hero__name {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 5.5rem);
    font-weight: 600;
    color: #f6f2f3;
    line-height: 1.05;
    margin: 0 0 var(--space-3);
    letter-spacing: -0.025em;
  }

  @media (min-width: 900px) {
    .hero__name {
      white-space: nowrap;
    }
  }

  @media (max-width: 767px) {
    .hero__name {
      font-size: clamp(2.5rem, 8vw, 3.5rem);
    }
  }

  .hero__discipline {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-surface-soft);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-6);
  }

  .hero__statement {
    font-size: clamp(0.9375rem, 1.8vw, 1.0625rem);
    color: rgba(246, 242, 243, 0.88);
    line-height: 1.7;
    max-width: 60ch;
    margin: 0 0 var(--space-6);
  }

  @media (max-width: 767px) {
    .hero__statement {
      max-width: 48ch;
    }
  }

  .hero__meta {
    max-width: 60ch;
    font-size: 0.8125rem;
    color: var(--color-surface-soft);
    margin: 0 0 var(--space-6);
  }

  .hero__meta p {
    margin: 0;
    line-height: 1.6;
  }

  .hero__meta p + p {
    margin-top: 3px;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  .hero__btn {
    display: inline-block;
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    text-decoration: none;
    padding: var(--space-3) var(--space-6);
    border-radius: var(--radius-md);
    transition:
      background-color var(--transition-duration) var(--transition-easing),
      border-color var(--transition-duration) var(--transition-easing),
      box-shadow var(--transition-duration) var(--transition-easing);
  }

  .hero__btn--primary {
    background-color: var(--color-wine);
    border: 1.5px solid var(--color-wine);
    color: #fff;
  }

  .hero__btn--primary:hover {
    background-color: var(--color-accent-hover);
    border-color: var(--color-accent-hover);
    color: #fff;
    box-shadow: 0 2px 8px rgba(182, 58, 70, 0.4);
  }

  .hero__btn--secondary {
    background-color: rgba(246, 242, 243, 0.12);
    border: 1.5px solid rgba(246, 242, 243, 0.42);
    color: #f6f2f3;
  }

  .hero__btn--secondary:hover {
    background-color: rgba(246, 242, 243, 0.22);
    border-color: rgba(246, 242, 243, 0.65);
    color: #fff;
  }

  /* ─── Current Research section ──────────────────────────────── */
  .research-section {
    padding-block: var(--space-16);
  }

  .research-section__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-wine);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-12);
    padding-inline: var(--content-padding-inline);
  }

  .research-feature {
    padding-inline: var(--content-padding-inline);
  }

  .research-feature + .research-feature {
    margin-top: var(--space-16);
  }

  /* ─── Research interests ────────────────────────────────────── */
  .interests-section {
    padding-block: var(--space-16);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .interests-section__heading {
    font-family: var(--font-display);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-10);
  }

  .interests-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-8) var(--space-10);
  }

  @media (max-width: 720px) {
    .interests-grid {
      grid-template-columns: 1fr;
    }
    .interest-divider {
      display: none;
    }
  }

  .interest-divider {
    grid-column: 1 / -1;
    height: 1px;
    background-color: var(--color-border);
  }

  .interest-item {
    /* No border or padding — clean editorial layout */
  }

  .interest-item__title {
    font-family: var(--font-display);
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--color-text);
    margin: 0 0 var(--space-3);
  }

  .interest-item__body {
    font-size: 0.875rem;
    color: var(--color-text-muted);
    line-height: 1.7;
    margin: 0;
  }

  /* ─── About preview — editorial, no card ───────────────────── */
  .about-preview {
    padding-block: var(--space-20);
    border-bottom: 1px solid var(--color-border);
  }

  .about-preview__inner {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1fr);
    gap: var(--space-12);
    align-items: center;
  }

  @media (max-width: 820px) {
    .about-preview__inner {
      grid-template-columns: 1fr;
    }
  }

  .about-preview__label {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--color-wine);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin: 0 0 var(--space-3);
  }

  .about-preview__heading {
    font-family: var(--font-display);
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.2;
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-5);
  }

  .about-preview__body {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    line-height: 1.75;
    max-width: 46ch;
    margin: 0 0 var(--space-5);
  }

  .about-preview__link {
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-wine);
    text-decoration: none;
    background: none;
  }

  .about-preview__link:hover {
    color: var(--color-accent-hover);
    background: none;
  }

  /* ─── Publication + contact sections ───────────────────────── */
  .pub-section {
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-border);
  }

  .contact-section {
    padding-block: var(--space-16);
  }

  .section-more {
    margin-top: var(--space-6);
    font-size: 0.875rem;
  }

  .contact-statement {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    max-width: 52ch;
    margin: 0 0 var(--space-6);
  }
</style>
